{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.3",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*|bun/*) ;; *) echo \"Use pnpm or bun instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/portfolio dev",
    "build": "pnpm --filter @workspace/portfolio build",
    "typecheck": "pnpm --filter @workspace/portfolio typecheck"
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.2",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.2",
    "lightningcss-darwin-arm64": "^1.32.0",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  }
}