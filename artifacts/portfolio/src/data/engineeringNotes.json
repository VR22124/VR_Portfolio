[
  {
    "id": "arch-01",
    "category": "Architecture",
    "title": "Start with the Problem",
    "lines": [
      "Don't choose the stack first.",
      "Understand the domain.",
      "Understand the users.",
      "Then design the system."
    ],
    "tags": ["architecture", "planning"]
  },
  {
    "id": "arch-02",
    "category": "Architecture",
    "title": "Foundations Before Features",
    "lines": [
      "Identity.",
      "Academic structure.",
      "Relationships.",
      "Features come after."
    ],
    "tags": ["architecture", "foundations"]
  },
  {
    "id": "arch-03",
    "category": "Architecture",
    "title": "Architecture Evolves",
    "lines": [
      "The first architecture isn't the final architecture.",
      "Refactor when the project grows.",
      "Don't predict everything upfront."
    ],
    "tags": ["architecture", "refactoring"]
  },
  {
    "id": "arch-04",
    "category": "Architecture",
    "title": "Platform Boundaries",
    "lines": [
      "Separate systems by responsibility.",
      "Not by technology."
    ],
    "tags": ["architecture", "design"]
  },
  {
    "id": "arch-05",
    "category": "Architecture",
    "title": "Modular Before Distributed",
    "lines": [
      "Build clear module boundaries.",
      "Distributed systems can come later.",
      "Don't over-engineer."
    ],
    "tags": ["architecture", "modules"]
  },
  {
    "id": "arch-06",
    "category": "Architecture",
    "title": "Don't Overengineer",
    "lines": [
      "Today's complexity rarely needs tomorrow's architecture."
    ],
    "tags": ["architecture", "simplicity"]
  },
  {
    "id": "arch-07",
    "category": "Architecture",
    "title": "Every Module Needs One Responsibility",
    "lines": [
      "One module.",
      "One purpose.",
      "No mixed responsibilities."
    ],
    "tags": ["architecture", "design"]
  },
  {
    "id": "plan-01",
    "category": "Planning",
    "title": "Think in Iterations",
    "lines": [
      "Never build large features.",
      "Split everything into the smallest deliverable iteration."
    ],
    "tags": ["planning", "process"]
  },
  {
    "id": "plan-02",
    "category": "Planning",
    "title": "Build a Roadmap",
    "lines": [
      "Know Version 1.",
      "Know what isn't Version 1."
    ],
    "tags": ["planning", "scope"]
  },
  {
    "id": "plan-03",
    "category": "Planning",
    "title": "Every Iteration Needs an Exit Condition",
    "lines": [
      "Know when the iteration is complete.",
      "Avoid endless development."
    ],
    "tags": ["planning", "process"]
  },
  {
    "id": "plan-04",
    "category": "Planning",
    "title": "Freeze Scope",
    "lines": [
      "Don't add features halfway through an iteration."
    ],
    "tags": ["planning", "scope"]
  },
